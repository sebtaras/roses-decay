---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { languages, defaultLang, getDictionary, withBase, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
}
const { lang, title = site.name } = Astro.props;
const t = getDictionary(lang);
// Social share preview image (1200px JPEG).
const ogImage = await getImage({ src: site.images.share, width: 1200, format: 'jpg' });
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const enPath = languages.en.path;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.meta.description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={absolute(ogImage.src)} />
    <meta property="og:url" content={absolute(languages[lang].path)} />
    <meta property="og:locale" content={lang === 'hr' ? 'hr_HR' : 'en_US'} />
    <link rel="canonical" href={absolute(languages[lang].path)} />
    {Object.entries(languages).map(([code, l]) => <link rel="alternate" hreflang={code} href={absolute(l.path)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(languages[defaultLang].path)} />
    <link rel="icon" type="image/png" href={withBase('favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Inter:wght@400;500;600&family=Permanent+Marker&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <!-- Runs before paint: apply the saved theme (or the system one) so there's no flash. -->
    <script is:inline>
      (function () {
        var theme;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'dark' && theme !== 'light') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <!-- First visit to the Croatian home page from a non-Croatian-speaking browser → English.
         Once someone picks a language with the switcher, that choice always wins. -->
    {lang === defaultLang && (
      <script is:inline define:vars={{ enPath }}>
        (function () {
          var saved;
          try { saved = localStorage.getItem('lang'); } catch (e) {}
          if (saved) {
            if (saved === 'en') location.replace(enPath + location.hash);
            return;
          }
          var langs = navigator.languages || [navigator.language || ''];
          var speaksLocal = langs.some(function (l) { return /^(hr|bs|sr|sh|cnr)\b/i.test(l); });
          if (!speaksLocal) location.replace(enPath + location.hash);
        })();
      </script>
    )}
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <!-- SVG filters for the hand-drawn look (used by .sketch and doodles) -->
    <svg width="0" height="0" class="absolute" aria-hidden="true">
      <filter id="rough">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" />
        <feDisplacementMap in="SourceGraphic" scale="3.5" />
      </filter>
    </svg>
    <slot />
  </body>
</html>
