---
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

<section id="listen" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-24 sm:px-8">
  <SectionHeading eyebrow="01 / Listen" title="Hear it loud" />
  <div class="overflow-hidden rounded-2xl border border-line bg-ink-2">
    <iframe
      title={`${site.name} on Spotify`}
      src={site.spotifyEmbed}
      width="100%"
      height="452"
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="lazy"
      class="block"
    ></iframe>
  </div>
</section>
