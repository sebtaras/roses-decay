---
import { site } from '../data/site';
const items = [
  { href: '#listen', label: 'Listen' },
  { href: '#about', label: 'About' },
  { href: '#links', label: 'Links' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300" data-nav>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
    <a href="#top" class="font-display text-xl tracking-wide uppercase">{site.name}</a>
    <ul class="flex gap-5 text-sm font-medium text-bone/80 sm:gap-8">
      {items.map((i) => (
        <li class={i.href === '#about' ? 'hidden sm:block' : ''}>
          <a href={i.href} class="transition-colors hover:text-accent">{i.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const nav = document.querySelector('[data-nav]');
  const onScroll = () => {
    const scrolled = window.scrollY > 40;
    nav?.classList.toggle('bg-ink/85', scrolled);
    nav?.classList.toggle('backdrop-blur', scrolled);
    nav?.classList.toggle('border-line', scrolled);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
