---
import { Image, getImage } from 'astro:assets';
import { site } from '../data/site';
import type { Dictionary } from '../i18n';
import Doodle from './deco/Doodle.astro';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;

// Every photo in the pool is pre-sized at build time; the browser picks one at random on load.
const widths = [828, 1280, 1920, 2560];
const pool = await Promise.all(
  site.images.heroPool.map(async (img) => {
    const r = await getImage({ src: img, widths, format: 'webp' });
    return { src: r.src, srcset: r.srcSet.attribute };
  }),
);
const fallback = pool[0];
---

<section id="top" class="grain relative flex min-h-[100svh] items-end overflow-hidden bg-night text-bone">
  <!-- src is set by the script below so only the chosen photo is downloaded -->
  <img
    data-hero-img
    alt=""
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover opacity-55 grayscale"
    fetchpriority="high"
    decoding="async"
  />
  <script is:inline define:vars={{ pool }}>
    (function () {
      var img = document.querySelector('[data-hero-img]');
      var i = Math.floor(Math.random() * pool.length);
      // avoid showing the same photo twice in a row
      try {
        var last = sessionStorage.getItem('heroPhoto');
        if (pool.length > 1 && String(i) === last) i = (i + 1 + Math.floor(Math.random() * (pool.length - 1))) % pool.length;
        sessionStorage.setItem('heroPhoto', String(i));
      } catch (e) {}
      img.srcset = pool[i].srcset;
      img.src = pool[i].src;
    })();
  </script>
  <noscript>
    <img
      src={fallback.src}
      srcset={fallback.srcset}
      alt=""
      sizes="100vw"
      class="absolute inset-0 h-full w-full object-cover opacity-55 grayscale"
    />
  </noscript>
  <div class="absolute inset-0 bg-gradient-to-t from-night via-night/50 to-night/20"></div>

  <div class="relative mx-auto w-full max-w-6xl px-5 pb-24 sm:px-8 sm:pb-32">
    <h1>
      <span class="sr-only">{site.name}</span>
      <Image
        src={site.logo}
        alt=""
        widths={[320, 640, 960]}
        sizes="(min-width: 640px) 420px, 70vw"
        class="h-auto w-[min(70vw,420px)] -rotate-2 drop-shadow-[0_8px_30px_rgba(0,0,0,0.6)]"
        loading="eager"
      />
    </h1>
    <p class="mt-6 max-w-md font-hand text-3xl leading-tight text-bone/90">{t.hero.tagline}</p>

    <div class="relative mt-10 flex flex-wrap items-center gap-5">
      <a
        href="#listen"
        class="sketch hover-wiggle px-8 py-3 font-marker text-xl text-bone uppercase"
        style="--sketch-fill: var(--color-accent); --sketch-color: var(--color-accent);"
      >
        {t.hero.listenNow}
      </a>
      <a
        href="#contact"
        class="sketch hover-wiggle px-8 py-3 font-marker text-xl uppercase"
        style="--sketch-color: var(--color-bone);"
      >
        {t.hero.bookUs}
      </a>
      <span class="hidden items-center gap-1 sm:flex">
        <Doodle name="arrow" class="h-10 w-20 -scale-x-100 rotate-12 text-hl" />
        <span class="-rotate-6 font-hand text-2xl text-hl">{t.hero.note}</span>
      </span>
    </div>
  </div>
</section>
