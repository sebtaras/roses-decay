---
import { site } from '../data/site';
---

<section id="top" class="grain relative flex min-h-[100svh] items-end overflow-hidden">
  <img
    src={site.images.hero}
    alt=""
    class="absolute inset-0 h-full w-full object-cover opacity-60"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-ink/10"></div>

  <div class="relative mx-auto w-full max-w-6xl px-5 pb-16 sm:px-8 sm:pb-24">
    <p class="mb-4 text-sm font-medium tracking-[0.3em] text-accent uppercase">New single out now</p>
    <h1 class="font-display text-[clamp(4rem,16vw,12rem)] leading-[0.85] uppercase">
      {site.name}
    </h1>
    <p class="mt-6 max-w-md text-lg text-bone/80">{site.tagline}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="#listen"
        class="rounded-full bg-accent px-7 py-3 font-semibold text-ink transition hover:bg-bone"
      >
        Listen now
      </a>
      <a
        href="#contact"
        class="rounded-full border border-bone/30 px-7 py-3 font-semibold transition hover:border-bone hover:bg-bone hover:text-ink"
      >
        Book us
      </a>
    </div>
  </div>
</section>
