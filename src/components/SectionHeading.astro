---
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<div class="mb-10">
  <p class="mb-3 text-xs font-semibold tracking-[0.3em] text-accent uppercase">{eyebrow}</p>
  <h2 class="font-display text-5xl leading-none uppercase sm:text-6xl">{title}</h2>
</div>
