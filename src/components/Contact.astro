---
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import ContactForm from './ContactForm';
---

<section id="contact" class="scroll-mt-20 border-t border-line bg-ink-2">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-24 sm:px-8 md:grid-cols-[1fr_1.4fr]">
    <div>
      <SectionHeading eyebrow="04 / Contact" title="Get in touch" />
      <p class="text-lg leading-relaxed text-bone/80">
        Booking, press, or just want to say hi? Drop us a line and we’ll get back to you.
      </p>
      <a href={`mailto:${site.email}`} class="mt-6 inline-block text-lg font-semibold text-accent hover:underline">
        {site.email}
      </a>
    </div>
    <ContactForm client:visible fallbackEmail={site.email} />
  </div>
</section>
